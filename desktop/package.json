{
  "name": "castor-desktop",
  "productName": "Castor",
  "version": "0.1.0",
  "description": "Castor — agent de code multi-providers : OpenRouter, Groq, OpenCode Zen et modèles locaux. Alternative optimisée à la CLI.",
  "main": "main.js",
  "author": "Castor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder --mwl"
  },
  "build": {
    "appId": "app.castor.desktop",
    "productName": "Castor",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*"],
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "Castor-macOS-${arch}.${ext}"
    },
    "win": {
      "target": ["zip"],
      "icon": "build/icon.png",
      "artifactName": "Castor-Windows-${arch}-portable.${ext}"
    },
    "linux": {
      "target": ["tar.gz"],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "Castor-Linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
